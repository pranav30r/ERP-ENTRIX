# ENTRIX System Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=entrix_erp

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_entrix_2026_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_entrix_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Python AI Microservice
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_SECRET=entrix_internal_ai_token_2026

# Amazon S3 / Object Storage (Optional for local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=entrix-documents-bucket
