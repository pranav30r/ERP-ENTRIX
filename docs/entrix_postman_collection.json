        },
        {
          "name": "POST Isolation Forest Anomaly Detection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\"id\": 1, \"amount\": 250.0, \"department_id\": 1},\n    {\"id\": 2, \"amount\": 310.0, \"department_id\": 1},\n    {\"id\": 3, \"amount\": 420.0, \"department_id\": 1},\n    {\"id\": 4, \"amount\": 98500.0, \"department_id\": 1}\n  ]\n}"
            },
            "url": {
              "raw": "{{aiUrl}}/api/v1/ml/anomaly/detect-expense",
              "host": ["{{aiUrl}}"],
              "path": ["api", "v1", "ml", "anomaly", "detect-expense"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Audit & Cryptographic Chain",
      "item": [
        {
          "name": "GET Cryptographic Audit Log Entries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit/logs?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit", "logs"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "GET Verify SHA-256 Hash Chain Integrity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit/verify-chain",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit", "verify-chain"]
            }
          }
        }
      ]
    }
  ]
}
